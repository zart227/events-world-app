# URL и порт бэкенда (для axios / RTK Query / socket.io)
REACT_APP_SERVER_URL=http://localhost
REACT_APP_SERVER_PORT=3001

# Яндекс-геокодер для страницы «Местоположение» (опционально)
REACT_APP_YANDEX_API_KEY=

GENERATE_SOURCEMAP=false

# Cypress e2e (опционально)
FRONTEND_PORT=3000
TEST_EMAIL=your_test_email@example.com
TEST_PASSWORD=your_test_password
# true — без моков API, нужны запущенные бэкенд и фронтенд
CYPRESS_USE_REAL_API=false
