# Переменные для docker compose (скопируйте в .env)

# Обязательно: секрет подписи JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# Ключ OpenWeatherMap (хранится только на сервере)
OPENWEATHERMAP_API_KEY=

# Email-адреса, получающие роль admin при регистрации (через запятую)
ADMIN_EMAILS=admin@example.com

# Ключ Яндекс-геокодера для страницы «Местоположение» (опционально)
REACT_APP_YANDEX_API_KEY=

# Порты (по умолчанию: фронт 3000, бэк 3001, postgres 5432, redis 6379)
FRONTEND_PORT=3000
BACKEND_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_PASSWORD=postgres
