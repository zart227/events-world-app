# Сервер
NODE_ENV=development
SERVER_PORT=3001
CLIENT_PORT=3000
# CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/events_world
PG_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379

# Аутентификация
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Email-адреса, получающие роль admin при регистрации (через запятую)
ADMIN_EMAILS=admin@example.com
RATE_LIMIT_ENABLED=true

# OpenWeatherMap (ключ хранится только на сервере)
OPENWEATHERMAP_API_KEY=
OWM_CACHE_TTL_SECONDS=1800
GEOCODE_CACHE_TTL_SECONDS=86400

# Фоновое обновление подписок (раз в час)
CRON_ENABLED=true
POLLUTION_REFRESH_CRON=0 * * * *
